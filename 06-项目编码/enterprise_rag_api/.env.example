# 对齐 03-技术文档/企业RAG_技术选型_v0.1.md · 勿填真实密钥入库
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enterprise_rag
DATABASE_URL=postgresql+psycopg2://rag:changeme@db:5432/enterprise_rag
# 本地无 Docker 冒烟可用 sqlite（pytest 默认覆盖）:
# DATABASE_URL=sqlite:///./test.db

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_rag_chunks

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 无 key 时自动 stub
EMBEDDING_STUB=auto

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_STUB=auto

JWT_SECRET=changeme-in-prod
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_ADMIN_DISPLAY=管理员

CHUNK_SIZE=800
CHUNK_OVERLAP=120
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

API_PORT=8088
WEB_PORT=3080
APP_VERSION=0.1.0
